<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the real module (spec §8.1, §11.3): SteamFrameEyeModule.cs, EyeProcessing.cs and the VRCFT-free face files,
       compiled against small stand-ins for the VRCFaceTracking types the module uses. The stand-ins are their own
       assembly, VRCFaceTracking.SDK 6.0.0.0 as VRCFaceTracking 6.0 loads it (StandIns/StandIns.csproj, kept out of this
       project's sources), so ExtTrackingModule does not live in the module's assembly. BCL only plus the vendored
       Microsoft.Extensions.Logging.Abstractions for ILogger: no VRCFaceTracking binary is referenced or loaded, so it
       runs anywhere with the .NET 10 SDK ("dotnet run" with this project, Release configuration).
       The eye rows bind 0.0.0.0 like the module and run only with MODULECHECKS_ALLOW_WILDCARD=1 (CI). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ModuleChecks</RootNamespace>
    <!-- The reference folder CI passes (-p:VrcftDir=...); without it the vendored copy (no VRCFT install is looked up). -->
    <VrcftDir Condition="'$(VrcftDir)' == ''">$(MSBuildThisFileDirectory)..\..\lib\vrcft-5.4.5</VrcftDir>
    <!-- StandIns/ is its own project (sources, bin and obj). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);StandIns/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\SteamFrameEyeModule.cs" Link="Module\SteamFrameEyeModule.cs" />
    <Compile Include="..\..\EyeProcessing.cs" Link="Module\EyeProcessing.cs" />
    <Compile Include="..\..\TestPorts.cs" Link="Module\TestPorts.cs" />
    <Compile Include="..\..\ModuleClaims.cs" Link="Module\ModuleClaims.cs" />
    <Compile Include="..\..\FaceOsc.cs" Link="Module\FaceOsc.cs" />
    <Compile Include="..\..\FaceMapping.cs" Link="Module\FaceMapping.cs" />
    <Compile Include="..\..\FaceSettings.cs" Link="Module\FaceSettings.cs" />
    <Compile Include="..\..\FaceReceiver.cs" Link="Module\FaceReceiver.cs" />
    <Compile Include="..\..\StatusKeeper.cs" Link="Module\StatusKeeper.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="StandIns\StandIns.csproj" />
  </ItemGroup>

  <!-- ILogger only; copied next to the checks so they can run (the module itself never ships it). -->
  <ItemGroup>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions">
      <HintPath>$(VrcftDir)\Microsoft.Extensions.Logging.Abstractions.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
