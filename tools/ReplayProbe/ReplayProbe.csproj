<Project Sdk="Microsoft.NET.Sdk">

  <!-- Replays a raw eye-server recording (headset/tools/record_eyes.py CSV) through the module's
       EyeProcessor and prints before/after statistics. Needs no VRCFaceTracking assemblies. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ReplayProbe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\EyeProcessing.cs" Link="EyeProcessing.cs" />
  </ItemGroup>

</Project>
