<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks of the module's VRCFT-free face code (spec §8, §11.3): BCL only, no VRCFaceTracking reference,
       so it runs anywhere with the .NET 10 SDK ("dotnet run" with this project, Release configuration). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FaceChecks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\TestPorts.cs" Link="TestPorts.cs" />
    <Compile Include="..\..\ModuleClaims.cs" Link="ModuleClaims.cs" />
    <Compile Include="..\..\FaceOsc.cs" Link="FaceOsc.cs" />
    <Compile Include="..\..\FaceMapping.cs" Link="FaceMapping.cs" />
    <Compile Include="..\..\FaceSettings.cs" Link="FaceSettings.cs" />
    <Compile Include="..\..\FaceReceiver.cs" Link="FaceReceiver.cs" />
    <Compile Include="..\..\StatusKeeper.cs" Link="StatusKeeper.cs" />
  </ItemGroup>

</Project>
