[Unit]
Description=FrameEye Bridge sender without SteamVR: Steam Frame eye tracking -> VRCFaceTracking (reads /dev/shm/eye-server.mmap)
After=default.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/frameeye/frameeye_osc.py --raw 172.16.0.156:9021
Restart=always
RestartSec=2
Nice=5

[Install]
WantedBy=default.target
