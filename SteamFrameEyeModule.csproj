<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SteamFrameEyeModule</AssemblyName>
    <RootNamespace>SteamFrameEyeModule</RootNamespace>
    <Version>0.5.2</Version>
    <Platforms>AnyCPU</Platforms>
    <!-- VRCFT 5.4.x ships as a self-contained .NET 10 app; modules are loaded into its
         VRCFaceTracking.ModuleProcess sandbox, so reference the VRCFT assemblies and do not
         copy them next to the module DLL. Resolution order: -p:VrcftDir=..., the local Steam
         install, then the vendored reference copies in lib/vrcft-5.4.5 (used by CI). -->
    <VrcftSteamDir>C:\Program Files (x86)\Steam\steamapps\common\VRCFaceTracking</VrcftSteamDir>
    <VrcftDir Condition="'$(VrcftDir)' == '' And Exists('$(VrcftSteamDir)\VRCFaceTracking.Core.dll')">$(VrcftSteamDir)</VrcftDir>
    <VrcftDir Condition="'$(VrcftDir)' == ''">$(MSBuildThisFileDirectory)lib\vrcft-5.4.5</VrcftDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- tools/ReplayProbe is its own project; keep its sources and build output out of the module. -->
    <Compile Remove="tools/**" />
    <None Remove="tools/**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VRCFaceTracking.SDK">
      <HintPath>$(VrcftDir)\VRCFaceTracking.SDK.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VRCFaceTracking.Core">
      <HintPath>$(VrcftDir)\VRCFaceTracking.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions">
      <HintPath>$(VrcftDir)\Microsoft.Extensions.Logging.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
